# Public: copy the project's API settings from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Administrator credentials: server only. Run npm run admin:sync after migrations.
# Keep ADMIN_PASSWORD out of NEXT_PUBLIC_* variables and source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Reelencer Admin
# Direct PostgreSQL/Supavisor session URL for migrations, with verified TLS.
DATABASE_URL=
# Optional trusted root certificate for verified PostgreSQL TLS.
# Download the certificate from the project's Database SSL settings.
DATABASE_SSL_CA_FILE=
# Alternatively inject the full PEM certificate through the deployment secret manager.
DATABASE_SSL_CA=
# Generate each secret independently: openssl rand -hex 32 
WORK_EMAIL_CRYPTO_SECRET=
GIG_INBOX_INGEST_SECRET=
CRON_SECRET=
# Cloudflare's GIG_INGEST_SECRET must match GIG_INBOX_INGEST_SECRET.
WORK_EMAIL_ALLOWED_DOMAINS=reelencer.com
GIG_ASSIGNMENT_EMAIL_DOMAIN=fasterdrop.site
# SMTP: local development or MAIL_SMTP_FALLBACK only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Email: Resend from the business domain. Verify the domain in Resend (Domains), then run npm run mail:check.
RESEND_API_KEY=
# Sender on the verified domain (never a Gmail address). Replies go to MAIL_REPLY_TO.
MAIL_FROM=Reelencer <hello@reelencer.com>
MAIL_REPLY_TO=support@reelencer.com
MAIL_DOMAIN=reelencer.com
# Resend → Webhooks → https://<site>/api/webhooks/resend (email.bounced, email.complained): its signing secret.
RESEND_WEBHOOK_SECRET=
# Optional: force a provider (resend|mailgun|smtp), or fall back to the SMTP settings above if Resend is down.
MAIL_PROVIDER=
MAIL_SMTP_FALLBACK=false
# Diagnostics contain request IDs and statuses, never request bodies or tokens.
API_REQUEST_LOGS=true
# Set only to a header overwritten by your trusted reverse proxy. Restrict direct origin access first.
# Supported: cf-connecting-ip, x-real-ip, x-forwarded-for, x-vercel-forwarded-for.
# Leave blank for local development (IP tracking/blocking disabled). Vercel detects its trusted header.
TRUSTED_CLIENT_IP_HEADER=
# Disabled for normal development and always disabled in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
ENABLE_DEV_ADMIN_BYPASS=false

# Linked-account auto-sync: public Instagram fallback plus optional official API connections.
# Local development starts a once-per-minute scheduler automatically. On long-running production Node hosts,
# set true to enable it; serverless hosts should POST /api/jobs/social-sync every minute with CRON_SECRET instead.
# Set false to disable the in-process scheduler in development.
SOCIAL_SYNC_IN_PROCESS=
# Seven-day deleted-worker cleanup starts automatically in local development.
# Long-running production Node hosts can enable it explicitly; serverless hosts use
# POST /api/jobs/worker-purge every minute with CRON_SECRET (also included in the Cloudflare worker).
WORKER_PURGE_IN_PROCESS=
# YouTube Data API v3 key (Google Cloud console → APIs & Services → Credentials). Public channel and video stats.
YOUTUBE_API_KEY=
# Instagram Graph API "business discovery": a long-lived token for a Meta app with instagram_basic +
# instagram_manage_insights, and the id of the Instagram Professional account that app manages. It can read
# followers and per-post likes/comments of any Professional (Creator/Business) account.
META_GRAPH_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0
# AI screenshot reader: reads followers, reach and reel views from insight screenshots creators upload (any platform,
# no platform API). Anthropic API key; can also be connected from Admin → Linked accounts → Auto-sync.
ANTHROPIC_API_KEY=
INSIGHTS_VISION_MODEL=claude-sonnet-5-5

# SEO. NEXT_PUBLIC_SITE_URL is the canonical production origin (e.g. https://reelencer.com) used for canonical links,
# the sitemap, Open Graph URLs and structured data. Search console verification tokens are optional.
NEXT_PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
