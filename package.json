{
  "name": "gig",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "deploy:worker": "wrangler deploy",
    "worker:secrets": "wrangler secret put GIG_INGEST_SECRET",
    "worker:update-url": "node scripts/update-tunnel-url.mjs",
    "backfill:assigned-emails": "node scripts/backfill-assigned-emails.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/backend/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check:backend": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-backend.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "lint:backend": "eslint lib/api \"app/api/**/route.ts\" \"app/api/**/_*.ts\" lib/secretCrypto.ts lib/supabaseAdmin.ts lib/applicationAutomationRules.ts cloudflare tests/backend lib/adminConfig.ts lib/adminOwner.ts lib/adminProvisioning.ts lib/adminAuth.ts lib/auth.ts",
    "check": "npm run typecheck && npm test && npm run lint:backend",
    "credentials:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/encrypt-credentials.mjs",
    "credentials:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/encrypt-credentials.mjs --apply",
    "admin:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-admin.mjs",
    "mail:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/mail-check.mjs",
    "admin:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-admin.mjs --check",
    "social:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-social-accounts.mjs",
    "social:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-social-accounts.mjs --check",
    "purge:workers": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/purge-workers.mjs",
    "purge:workers:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/purge-workers.mjs --check",
    "wallet:reconcile": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/reconcile-approved-reels.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "mailparser": "^3.14.1",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "nvm": "^0.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.30",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
